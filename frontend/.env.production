# Production environment variables
# Replace with your actual backend Vercel URL after deploying backend
REACT_APP_API_URL=https://your-backend-url.vercel.app

# Steps to update:
# 1. Deploy your backend to Vercel first
# 2. Copy the backend URL (e.g., https://talkspace-backend-xyz.vercel.app)
# 3. Replace the URL above
# 4. Also add this to Vercel Dashboard → Settings → Environment Variables
